PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# Python AI service
AI_URL=http://127.0.0.1:8000
AI_ADMIN_TOKEN=change-me          # lets the web app trigger retraining (set the same value for both processes)
AI_RETRAIN_HOURS=0                # e.g. 24 to retrain daily on real accept/decline data
ADMIN_EMAILS=you@example.com      # accounts allowed to call POST /api/admin/retrain

# Real database (optional, default is a JSON file). Start one with: docker compose up -d mongo
MONGO_URL=
MONGO_DB=roomiematch

# E-mail (optional, needs `nodemailer`; without it links are printed in the terminal)
SMTP_URL=
MAIL_FROM=RoomieMatch <no-reply@example.com>

# Photo storage (optional, default is local disk; needs @aws-sdk/client-s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=
